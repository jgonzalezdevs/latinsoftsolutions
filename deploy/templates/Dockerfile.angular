# Template Dockerfile para aplicaciones Angular
# Copia este archivo a tu proyecto Angular y renombralo a "Dockerfile"

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Build for production
# Ajusta el comando si tu proyecto usa un script diferente
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy nginx config for SPA
# Asegurate de crear el archivo nginx/default.conf en tu proyecto
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy built application
# Ajusta la ruta segun tu configuracion de angular.json
# Por defecto: dist/<nombre-proyecto>/browser
COPY --from=builder /app/dist/*/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
